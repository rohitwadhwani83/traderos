# ==============================================================================
# TRADEROS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application
VITE_APP_NAME="TraderOS"
VITE_APP_URL="http://localhost:5173"
VITE_APP_ENV="development"

# AI Provider Configuration (Google Gemini / Anthropic / OpenAI)
VITE_AI_PROVIDER="gemini"
VITE_GEMINI_API_KEY="your-gemini-api-key-here"
# VITE_ANTHROPIC_API_KEY="your-anthropic-api-key-here"
# VITE_OPENAI_API_KEY="your-openai-api-key-here"

# Database & Authentication (Supabase / PostgreSQL)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key-here"

# Market Data Providers (Optional for live broker or exchange data)
# Supported: NSE Feed, Binance Spot, Alpha Vantage, Polygon
VITE_BINANCE_API_ENDPOINT="https://api.binance.com"
VITE_MARKET_DATA_PROVIDER="default" # 'default' uses verified live mock engine with fallbacks

# Default User Currency ('INR' | 'USD' | 'USDT')
VITE_DEFAULT_CURRENCY="INR"
